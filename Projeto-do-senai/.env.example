# Copie para .env e ajuste. O .env nao vai para o Git.
#
#   cp .env.example .env

POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=ocorrenciaescolar
POSTGRES_PORT=5432

# Precisa de no minimo 32 caracteres — a aplicacao recusa subir com menos.
# Para gerar um: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-aleatorio-de-no-minimo-32-caracteres

APP_PORT=8080
APP_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Publicacao de eventos no RabbitMQ. Com false, os eventos vao para o log.
# Para ligar: docker compose --profile messaging up
APP_RABBIT_ENABLED=false
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
